{
  "schemaVersion": 1,
  "repository": "StarJunkyard-iOS",
  "branchPolicy": {
    "requiredPrefix": "issue/",
    "forbiddenFragments": ["codex"]
  },
  "validationProfiles": {
    "full-ios": [
      {
        "name": "Python contract tests",
        "command": ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"]
      },
      {
        "name": "Release contracts and pixel assets",
        "command": ["python3", "tools/validate_project.py", "--release"]
      },
      {
        "name": "Generate Xcode project",
        "command": ["tuist", "generate", "--no-open"]
      },
      {
        "name": "iOS XCTest",
        "command": [
          "xcodebuild",
          "-project", "StarJunkyard.xcodeproj",
          "-scheme", "StarJunkyard",
          "-configuration", "Debug",
          "-quiet",
          "-destination", "platform=iOS Simulator,id={simulator_id}",
          "-derivedDataPath", "{derived_data_path}",
          "CODE_SIGNING_ALLOWED=NO",
          "test"
        ]
      }
    ],
    "app-store-release": [
      {
        "name": "Complete unsigned App Store release regression",
        "command": ["python3", "tools/release_regression.py"]
      }
    ],
    "pixel-pack": [
      {
        "name": "Build and exact-match the current pixel pack",
        "command": ["python3", "tools/integrate_world_pixel_packs.py", "--build-current-pack"]
      },
      {
        "name": "Check immutable R3-R6 world contracts",
        "command": ["python3", "tools/integrate_world_pixel_packs.py", "--check-contracts"]
      },
      {
        "name": "Validate pixel pack integration fixtures",
        "command": ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_world_pixel_pack_integration.py"]
      },
      {
        "name": "Release contracts and production pixel assets",
        "command": ["python3", "tools/validate_project.py", "--release"]
      }
    ]
  },
