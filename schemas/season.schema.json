{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starjunkyard.local/schemas/season.schema.json",
  "title": "StarJunkyard eight-week season contract",
  "type": "object",
  "required": [
    "schemaVersion", "contentVersion", "seasonID", "titleKo", "startsAt", "endsAt", "selectionSeed",
    "weeklyXPCap", "codexEntryID", "dailyMissionPool", "weeklyMissions", "rewardTiers"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "contentVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "seasonID": {"type": "string", "pattern": "^season_[0-9]{4}_[0-9]{2}$"},
    "titleKo": {"type": "string", "minLength": 1},
    "startsAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "endsAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "selectionSeed": {"type": "integer", "minimum": 1},
    "weeklyXPCap": {"const": 2500},
    "codexEntryID": {"type": "string", "minLength": 1},
    "dailyMissionPool": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/mission"}
    },
    "weeklyMissions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/mission"}
    },
    "rewardTiers": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/tier"}
    }
  },
  "$defs": {
    "metric": {
      "enum": [
        "dismantle_enemy", "salvage_part", "manual_salvage", "crew_attack",
        "clear_stage", "facility_job", "defeat_boss", "expedition_complete"
      ]
    },
    "mission": {
      "type": "object",
      "required": ["id", "titleKo", "cadence", "metric", "target", "xp"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "titleKo": {"type": "string", "minLength": 1},
        "cadence": {"enum": ["daily", "weekly"]},
        "metric": {"$ref": "#/$defs/metric"},
        "target": {"type": "integer", "minimum": 1},
        "xp": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    },
    "reward": {
      "type": "object",
      "required": ["kind", "itemID", "amount"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["currency", "material", "story", "cosmetic", "convenience"]},
        "itemID": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "amount": {"type": "integer", "minimum": 1}
      }
    },
    "tier": {
      "type": "object",
      "required": ["level", "xpRequired", "free", "premium"],
      "additionalProperties": false,
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 40},
        "xpRequired": {"type": "integer", "minimum": 500, "maximum": 20000},
        "free": {"$ref": "#/$defs/reward"},
        "premium": {"$ref": "#/$defs/reward"}
      }
    }
  }
}
