{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starjunkyard.local/schemas/content.schema.json",
  "title": "StarJunkyard content contract",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "slice", "player", "drones", "enemies", "stages", "economy"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "contentVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "slice": {
      "type": "object",
      "required": ["id", "regionId", "stageStart", "stageEnd"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "regionId": {"type": "string"},
        "stageStart": {"type": "integer", "minimum": 1},
        "stageEnd": {"type": "integer", "minimum": 1}
      }
    },
    "player": {"$ref": "#/$defs/player"},
    "drones": {"type": "array", "items": {"$ref": "#/$defs/drone"}, "minItems": 1},
    "enemies": {"type": "array", "items": {"$ref": "#/$defs/enemy"}, "minItems": 1},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}, "minItems": 1},
    "economy": {"$ref": "#/$defs/economy"}
  },
  "$defs": {
    "positivePpm": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "player": {
      "type": "object",
      "required": ["id", "baseDamage", "attackIntervalMs", "criticalChancePpm", "criticalDamagePpm", "spriteId"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "baseDamage": {"type": "integer", "minimum": 1},
        "attackIntervalMs": {"type": "integer", "minimum": 50},
        "criticalChancePpm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "criticalDamagePpm": {"$ref": "#/$defs/positivePpm"},
        "spriteId": {"type": "string"}
      }
    },
    "drone": {
      "type": "object",
      "required": ["id", "nameKo", "role", "baseDamage", "attackIntervalMs", "unlockStage", "spriteId"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "nameKo": {"type": "string"},
        "role": {"type": "string"},
        "baseDamage": {"type": "integer", "minimum": 1},
        "attackIntervalMs": {"type": "integer", "minimum": 50},
        "unlockStage": {"type": "integer", "minimum": 1},
        "spriteId": {"type": "string"}
      }
    },
    "enemy": {
      "type": "object",
      "required": ["id", "nameKo", "class", "hpMultiplierPpm", "weakness", "spriteId"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "nameKo": {"type": "string"},
        "class": {"enum": ["normal", "elite", "boss"]},
        "hpMultiplierPpm": {"$ref": "#/$defs/positivePpm"},
        "weakness": {"enum": ["cut", "impact", "heat", "electric", "cooling"]},
        "spriteId": {"type": "string"}
      }
    },
    "stage": {
      "type": "object",
      "required": ["number", "baseHp", "baseReward", "wave", "rewardMultiplierPpm", "encounterClass", "expectedClearSeconds", "firstClearReward"],
      "additionalProperties": false,
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "baseHp": {"type": "integer", "minimum": 1},
        "baseReward": {"type": "integer", "minimum": 1},
        "wave": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 8},
        "bossTier": {"type": "integer", "minimum": 1},
        "timeLimitMs": {"type": "integer", "minimum": 10000, "maximum": 75000},
        "rewardMultiplierPpm": {"$ref": "#/$defs/positivePpm"},
        "encounterClass": {"enum": ["normal", "elite", "boss", "regionBoss"]},
        "expectedClearSeconds": {"type": "integer", "minimum": 10, "maximum": 300},
        "firstClearReward": {"$ref": "#/$defs/wallet"}
      }
    },
    "wallet": {
      "type": "object",
      "required": ["credits", "parts", "circuits", "alloy", "starCores"],
      "additionalProperties": false,
      "properties": {
        "credits": {"type": "integer", "minimum": 0},
        "parts": {"type": "integer", "minimum": 0},
        "circuits": {"type": "integer", "minimum": 0},
        "alloy": {"type": "integer", "minimum": 0},
        "starCores": {"type": "integer", "minimum": 0}
      }
    },
    "economy": {
      "type": "object",
      "required": ["currencies", "enemyPartRewards", "offline", "launch", "upgradeSinks"],
      "additionalProperties": false,
      "properties": {
        "currencies": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "nameKo", "primarySource", "primarySink"],
            "additionalProperties": false,
            "properties": {
              "id": {"enum": ["credits", "parts", "circuits", "alloy", "starCores"]},
              "nameKo": {"type": "string", "minLength": 1},
              "primarySource": {"type": "string", "minLength": 1},
              "primarySink": {"type": "string", "minLength": 1}
            }
          }
        },
        "enemyPartRewards": {
          "type": "object",
          "required": ["normal", "elite", "boss"],
          "additionalProperties": false,
          "properties": {
            "normal": {"type": "integer", "minimum": 1},
            "elite": {"type": "integer", "minimum": 1},
            "boss": {"type": "integer", "minimum": 1}
          }
        },
        "offline": {
          "type": "object",
          "required": ["efficiencyPpm", "cycleSeconds", "freeCapSeconds"],
          "additionalProperties": false,
          "properties": {
            "efficiencyPpm": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "cycleSeconds": {"type": "integer", "minimum": 1},
            "freeCapSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "launch": {
          "type": "object",
          "required": ["requiredStage", "cost"],
          "additionalProperties": false,
          "properties": {
            "requiredStage": {"type": "integer", "minimum": 1},
            "cost": {"$ref": "#/$defs/wallet"}
          }
        },
        "upgradeSinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "nameKo", "cost"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "nameKo": {"type": "string", "minLength": 1},
              "cost": {"$ref": "#/$defs/wallet"}
            }
          }
        }
      }
    }
  }
}
