{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starjunkyard.local/schemas/asset-manifest.schema.json",
  "title": "StarJunkyard pixel asset manifest",
  "type": "object",
  "required": ["schemaVersion", "logicalViewport", "paletteId", "assets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "logicalViewport": {"const": [360, 800]},
    "paletteId": {"const": "common16"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "canvas", "pivot", "scalePolicy", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "kind": {"enum": ["actor", "drone", "enemy_small", "enemy_medium", "enemy_large", "boss", "background", "facility", "ui", "fx"]},
          "canvas": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
          "pivot": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
          "scalePolicy": {"const": "integer_nearest"},
          "status": {"enum": ["planned", "placeholder", "production_ready"]},
          "file": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
